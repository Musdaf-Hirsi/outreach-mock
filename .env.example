# DeepSeek is OpenAI-compatible — same key/base-url shape as OpenAI SDKs
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Valid model names as of this writing: deepseek-v4-pro or deepseek-v4-flash
# ("deepseek-chat" was retired and will fail with invalid_request_error).
DEEPSEEK_MODEL=deepseek-v4-flash

# Get a free key at https://console.cloud.google.com/apis/credentials
# after enabling "YouTube Data API v3" for your project.
YOUTUBE_API_KEY=your-youtube-api-key-here
# Biases discovery search results toward English-market creators (a free
# search-time tilt toward the "golden country" audiences the course wants —
# US/UK/Canada/Australia). Override if targeting a non-English niche.
YOUTUBE_RELEVANCE_LANGUAGE=en
YOUTUBE_REGION_CODE=US

# Gmail sending — create an "OAuth client ID" (type: Desktop app) at
# https://console.cloud.google.com/apis/credentials after enabling "Gmail API".
# Then run `npm run gmail-auth` once to authorize your account.
GMAIL_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REDIRECT_URI=http://localhost:53682/callback

# Send pacing — protects a personal/non-warmed-up Gmail account from being
# spam-flagged or rate-limited by a burst of cold outreach. Raise these only
# once you're sending from a properly warmed-up dedicated domain.
GMAIL_DAILY_SEND_LIMIT=40
GMAIL_SEND_DELAY_MS=8000

# Optional — live-syncs the tracking sheet (found candidates + contacted) to
# a real Google Sheet you own, using the same Gmail OAuth account above
# (needs the "spreadsheets" scope — enable "Google Sheets API" in the same
# Cloud project as Gmail, then re-run `npm run gmail-auth` once). Paste the
# sheet's ID or its full share URL — either works.
GOOGLE_SHEETS_ID=

# Optional — Apollo.io email enrichment, used to fill in a creator's real
# contact email when YouTube's API and public channel/video descriptions
# don't turn one up. Requires a paid Apollo plan for email reveal; get a key
# from Settings > Integrations > API at https://app.apollo.io. Leave unset
# to skip Apollo lookups entirely (the app works fine without it — you'll
# just keep supplying emails by hand for candidates it can't find).
APOLLO_API_KEY=

# Optional — what this agency can actually offer beyond the intro
# (scripting, brand research, handling the outreach itself, etc.). Used by
# the negotiation agent specifically when negotiating a discount through a
# creator's agency (course technique: "Closing an Influencer That Has an
# Agency" — frame the discount as a trade for a real service, not a bare
# markdown ask). Leave unset and the agent falls back to budget-constraint
# framing instead of inventing a capability it wasn't told about.
AGENCY_SERVICES_OFFERED=
